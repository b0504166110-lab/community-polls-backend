# ===========================================================
#  משתני סביבה - העתיקי את הקובץ הזה לקובץ חדש בשם .env
#  ומלאי ערכים אמיתיים. לעולם אל תעלי את .env ל-GitHub!
# ===========================================================

# סביבת ההרצה: development / production / test
NODE_ENV=development

# הפורט של השרת (ב-Render הפורט נקבע אוטומטית)
PORT=3000

# כתובת החיבור למסד הנתונים PostgreSQL
# דוגמה למחשב מקומי:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_polls?schema=public"
# דוגמה ל-Neon (מקבלים אותה באתר של Neon):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# מפתח סודי לחתימת JWT - מחרוזת אקראית ארוכה (לפחות 32 תווים)
# אפשר ליצור כזו בפקודה: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# תוקף ה-Token (לדוגמה: 15m, 2h, 1d)
JWT_EXPIRES_IN=2h

# הכתובות שמותר להן לפנות לשרת מהדפדפן (אתר ה-React), מופרדות בפסיק
# * = כל כתובת (מתאים רק לפיתוח)
CORS_ORIGIN=http://localhost:5173

# ===== חשבונות בעת הרצת ה-Seed =====
# בפיתוח: אם לא מגדירים - ייווצרו משתמשי הדגמה עם סיסמאות ידועות (ראי README).
# בפרודקשן: המנהל נוצר רק אם מוגדרים שני המשתנים הבאים.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=מנהל האתר

# בפרודקשן: אם מוגדרת סיסמה כאן - ייווצרו גם משתמשי הדגמה וסקרי הדגמה עם הסיסמה הזו
SEED_DEMO_PASSWORD=

# ===== בדיקות אוטומטיות בלבד =====
# מסד נתונים נפרד לבדיקות! הבדיקות מוחקות את כל הנתונים שבו.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_polls_test?schema=public"
