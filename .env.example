# העתיקי את הקובץ הזה לקובץ חדש בשם .env ומלאי ערכים אמיתיים.
# לעולם אל תעלי את .env ל-GitHub!

NODE_ENV=development
PORT=3000

# כתובת מסד הנתונים PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_polls?schema=public"

# מפתח סודי ל-JWT - מחרוזת אקראית של לפחות 32 תווים
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=2h

# כתובת אתר ה-React (אפשר כמה, מופרדות בפסיק)
CORS_ORIGIN=http://localhost:5173

# חשבון המנהל שנוצר ב-Seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=מנהל האתר

# בפרודקשן: סיסמה למשתמשי וסקרי הדגמה (לא חובה)
SEED_DEMO_PASSWORD=

# מסד נתונים נפרד לבדיקות אוטומטיות (הבדיקות מוחקות בו נתונים!)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_polls_test?schema=public"
